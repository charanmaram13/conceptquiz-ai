{
  "name": "conceptquiz-ai",
  "version": "1.0.0",
  "description": "AI-Powered Adaptive Quiz Generator for technical and academic concept mastery",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -n \"API,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "ai",
    "quiz",
    "adaptive-learning",
    "gemma",
    "gemini",
    "education"
  ],
  "author": "ConceptQuiz AI Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^0.1.2",
    "@google/generative-ai": "^0.24.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
